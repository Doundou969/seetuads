"use client";

import { useState, useMemo } from "react";
import { createCampaign } from "@/lib/actions";
import { Button } from "@/components/ui/button";
import { Monitor, Calendar, Clock, Calculator } from "lucide-react";

interface Screen {
  id: string;
  screenCode: string;
  name: string | null;
  location: { name: string } | null;
  zone: { name: string; id: string } | null;
  monthlyPartnerFee: number;
}

interface PricingRule {
  id: string;
  zoneId: string | null;
  screenId: string | null;
  basePrice: number;
  durationMultiplier: number;
  frequencyMultiplier: number;
  zoneMultiplier: number;
}

export function CampaignForm({
  screens,
  pricingRules,
}: {
  screens: Screen[];
  pricingRules: PricingRule[];
}) {
  const [selectedScreens, setSelectedScreens] = useState<string[]>([]);
  const [spotDuration, setSpotDuration] = useState(15);
  const [frequency, setFrequency] = useState(1);
  const [startDate, setStartDate] = useState("");
  const [endDate, setEndDate] = useState("");

  const toggleScreen = (id: string) => {
    setSelectedScreens((prev) =>
      prev.includes(id) ? prev.filter((s) => s !== id) : [...prev, id]
    );
  };

  const estimatedPrice = useMemo(() => {
    if (!startDate || !endDate || selectedScreens.length === 0) return 0;

    const start = new Date(startDate);
    const end = new Date(endDate);
    const days = Math.max(1, Math.ceil((end.getTime() - start.getTime()) / (1000 * 60 * 60 * 24)));

    let total = 0;
    for (const screenId of selectedScreens) {
      const screen = screens.find((s) => s.id === screenId);
      if (!screen) continue;

      const rule =
        pricingRules.find((pr) => pr.screenId === screenId) ||
        pricingRules.find((pr) => pr.zoneId === screen.zone?.id) ||
        pricingRules[0];

      if (rule) {
        const dailyPrice =
          Number(rule.basePrice) *
          Number(rule.durationMultiplier) *
          Number(rule.frequencyMultiplier) *
          Number(rule.zoneMultiplier);
        total += dailyPrice * days;
      }
    }
    return Math.round(total);
  }, [selectedScreens, spotDuration, frequency, startDate, endDate, screens, pricingRules]);

  const handleSubmit = (formData: FormData) => {
    formData.set("screenIds", JSON.stringify(selectedScreens));
    formData.set("estimatedPrice", estimatedPrice.toString());
    return createCampaign(formData);
  };

  return (
    <form action={handleSubmit} className="space-y-8 max-w-4xl">
      {/* INFOS DE BASE */}
      <div className="bg-white p-6 rounded-xl border space-y-4">
        <h2 className="text-lg font-semibold flex items-center gap-2">
          <Calendar className="w-5 h-5 text-primary-600" />
          Informations generales
        </h2>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label htmlFor="name" className="block text-sm font-medium text-gray-700 mb-1">
              Nom de la campagne
            </label>
            <input
              id="name"
              name="name"
              required
              placeholder="Campagne Ete 2024"
              className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500"
            />
          </div>
          <div>
            <label htmlFor="objective" className="block text-sm font-medium text-gray-700 mb-1">
              Objectif
            </label>
            <input
              id="objective"
              name="objective"
              placeholder="Notoriete, ventes..."
              className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500"
            />
          </div>
          <div>
            <label htmlFor="startDate" className="block text-sm font-medium text-gray-700 mb-1">
              Date de debut
            </label>
            <input
              id="startDate"
              name="startDate"
              type="date"
              required
              value={startDate}
              onChange={(e) => setStartDate(e.target.value)}
              className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500"
            />
          </div>
          <div>
            <label htmlFor="endDate" className="block text-sm font-medium text-gray-700 mb-1">
              Date de fin
            </label>
            <input
              id="endDate"
              name="endDate"
              type="date"
              required
              value={endDate}
              onChange={(e) => setEndDate(e.target.value)}
              className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500"
            />
          </div>
        </div>
      </div>

      {/* CONFIGURATION DU SPOT */}
      <div className="bg-white p-6 rounded-xl border space-y-4">
        <h2 className="text-lg font-semibold flex items-center gap-2">
          <Clock className="w-5 h-5 text-primary-600" />
          Configuration du spot
        </h2>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label htmlFor="spotDuration" className="block text-sm font-medium text-gray-700 mb-1">
              Duree du spot (secondes)
            </label>
            <input
              id="spotDuration"
              name="spotDuration"
              type="number"
              min={5}
              max={60}
              value={spotDuration}
              onChange={(e) => setSpotDuration(Number(e.target.value))}
              className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500"
            />
          </div>
          <div>
            <label htmlFor="frequencyPerLoop" className="block text-sm font-medium text-gray-700 mb-1">
              Frequence par boucle
            </label>
            <input
              id="frequencyPerLoop"
              name="frequencyPerLoop"
              type="number"
              min={1}
              max={10}
              value={frequency}
              onChange={(e) => setFrequency(Number(e.target.value))}
              className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500"
            />
          </div>
        </div>
      </div>

      {/* SELECTION DES ECRANS */}
      <div className="bg-white p-6 rounded-xl border space-y-4">
        <h2 className="text-lg font-semibold flex items-center gap-2">
          <Monitor className="w-5 h-5 text-primary-600" />
          Selection des ecrans ({selectedScreens.length} selectionne{selectedScreens.length > 1 ? "s" : ""})
        </h2>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
          {screens.map((screen) => (
            <label
              key={screen.id}
              className={`flex items-center gap-3 p-4 rounded-lg border cursor-pointer transition ${
                selectedScreens.includes(screen.id)
                  ? "border-primary-500 bg-primary-50"
                  : "border-gray-200 hover:border-gray-300"
              }`}
            >
              <input
                type="checkbox"
                checked={selectedScreens.includes(screen.id)}
                onChange={() => toggleScreen(screen.id)}
                className="w-4 h-4 text-primary-600 rounded focus:ring-primary-500"
              />
              <div className="flex-1">
                <p className="font-medium text-sm">{screen.name || screen.screenCode}</p>
                <p className="text-xs text-gray-500">
                  {screen.location?.name} • {screen.zone?.name || "Sans zone"}
                </p>
              </div>
            </label>
          ))}
        </div>
      </div>

      {/* PRIX ESTIME */}
      <div className="bg-primary-50 p-6 rounded-xl border border-primary-200">
        <h2 className="text-lg font-semibold flex items-center gap-2 text-primary-800">
          <Calculator className="w-5 h-5" />
          Prix estime
        </h2>
        <div className="mt-4 flex items-baseline gap-2">
          <span className="text-4xl font-bold text-primary-700">
            {estimatedPrice.toLocaleString("fr-FR")}
          </span>
          <span className="text-primary-600">XOF</span>
        </div>
        <p className="text-sm text-primary-600 mt-2">
          {selectedScreens.length} ecran{selectedScreens.length > 1 ? "s" : ""} • {" "}
          {startDate && endDate
            ? Math.max(
                1,
                Math.ceil(
                  (new Date(endDate).getTime() - new Date(startDate).getTime()) /
                    (1000 * 60 * 60 * 24)
                )
              )
            : 0}{" "}
          jour(s)
        </p>
      </div>

      <div className="flex gap-4">
        <Button type="submit" size="lg" disabled={selectedScreens.length === 0}>
          Creer la campagne
        </Button>
        <Button type="button" variant="outline" size="lg" onClick={() => history.back()}>
          Annuler
        </Button>
      </div>
    </form>
  );
}