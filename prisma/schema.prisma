generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String              @id @default(uuid())
  clerkUserId     String              @unique @map("clerk_user_id")
  role            UserRole            @default(ADVERTISER)
  email           String?
  firstName       String?             @map("first_name")
  lastName        String?             @map("last_name")
  phone           String?
  avatarUrl       String?             @map("avatar_url")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  advertiser      Advertiser?
  auditLogs       AuditLog[]
  assignedTickets MaintenanceTicket[] @relation("AssignedTo")
  reportedTickets MaintenanceTicket[] @relation("ReportedBy")
  notifications   Notification[]
  partner         Partner?

  @@map("users")
}

model Advertiser {
  id           String                  @id @default(uuid())
  userId       String                  @unique @map("user_id")
  companyName  String                  @map("company_name")
  contactName  String?                 @map("contact_name")
  phone        String?
  email        String
  industry     String?
  address      String?
  city         String                  @default("Dakar")
  country      String                  @default("Senegal")
  status       AdvertiserStatus        @default(PENDING)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  accessTokens AdvertiserAccessToken[]
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]
  media        Media[]
  payments     Payment[]

  @@map("advertisers")
}

model AdvertiserAccessToken {
  id           String     @id @default(uuid())
  advertiserId String     @map("advertiser_id")
  tokenHash    String     @unique @map("token_hash")
  expiresAt    DateTime   @map("expires_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  lastUsedAt   DateTime?  @map("last_used_at")
  revokedAt    DateTime?  @map("revoked_at")
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@index([advertiserId])
  @@index([expiresAt])
  @@map("advertiser_access_tokens")
}

model Partner {
  id           String          @id @default(uuid())
  userId       String          @unique @map("user_id")
  businessName String          @map("business_name")
  ownerName    String?         @map("owner_name")
  phone        String
  email        String?
  businessType String?         @map("business_type")
  address      String?
  city         String          @default("Dakar")
  latitude     Decimal?        @db.Decimal(10, 8)
  longitude    Decimal?        @db.Decimal(11, 8)
  status       EntityStatus    @default(PENDING)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  contracts    Contract[]
  locations    Location[]
  payouts      PartnerPayout[]
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("partners")
}

model Location {
  id           String       @id @default(uuid())
  partnerId    String       @map("partner_id")
  name         String
  businessType String?      @map("business_type")
  address      String
  city         String       @default("Dakar")
  district     String?
  latitude     Decimal?     @db.Decimal(10, 8)
  longitude    Decimal?     @db.Decimal(11, 8)
  description  String?
  photos       Json?        @default("[]")
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  partner      Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  screens      Screen[]

  @@map("locations")
}

model Zone {
  id           String        @id @default(uuid())
  name         String
  city         String        @default("Dakar")
  district     String?
  description  String?
  latitude     Decimal?      @db.Decimal(10, 8)
  longitude    Decimal?      @db.Decimal(11, 8)
  radiusMeters Int           @default(1000) @map("radius_meters")
  status       EntityStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  pricingRules PricingRule[]
  screens      Screen[]

  @@map("zones")
}

model Screen {
  id                    String                 @id @default(uuid())
  locationId            String                 @map("location_id")
  zoneId                String?                @map("zone_id")
  screenCode            String                 @unique @map("screen_code")
  name                  String?
  widthPx               Int                    @default(1920) @map("width_px")
  heightPx              Int                    @default(1080) @map("height_px")
  resolution            String                 @default("1920x1080")
  orientation           String                 @default("landscape")
  status                ScreenStatus           @default(OFFLINE)
  installationDate      DateTime?              @map("installation_date") @db.Date
  monthlyPartnerFee     Decimal                @default(20000.00) @map("monthly_partner_fee") @db.Decimal(12, 2)
  inventoryLoopSeconds  Int                    @default(120) @map("inventory_loop_seconds")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  campaignScreens       CampaignScreen[]
  contracts             Contract[]
  inventoryReservations InventoryReservation[]
  maintenanceTickets    MaintenanceTicket[]
  partnerPayouts        PartnerPayout[]
  playbackLogs          PlaybackLog[]
  player                Player?
  playlists             Playlist[]
  pricingRules          PricingRule[]
  screenCosts           ScreenCost[]
  location              Location               @relation(fields: [locationId], references: [id])
  zone                  Zone?                  @relation(fields: [zoneId], references: [id])

  @@map("screens")
}

model Player {
  id                 String              @id @default(uuid())
  screenId           String?             @unique @map("screen_id")
  deviceId           String              @unique @map("device_id")
  serialNumber       String?             @map("serial_number")
  appVersion         String              @default("1.0.0") @map("app_version")
  osVersion          String?             @map("os_version")
  lastHeartbeat      DateTime?           @map("last_heartbeat")
  status             PlayerStatus        @default(UNREGISTERED)
  lastIp             String?             @map("last_ip")
  storageStatus      Json?               @map("storage_status")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  apiKey             String              @unique @default(uuid()) @map("api_key")
  maintenanceTickets MaintenanceTicket[]
  playbackLogs       PlaybackLog[]
  screen             Screen?             @relation(fields: [screenId], references: [id])

  @@map("players")
}

model Media {
  id              String          @id @default(uuid())
  advertiserId    String          @map("advertiser_id")
  name            String
  fileUrl         String          @map("file_url")
  fileType        String          @map("file_type")
  mimeType        String?         @map("mime_type")
  widthPx         Int?            @map("width_px")
  heightPx        Int?            @map("height_px")
  durationSeconds Int             @default(15) @map("duration_seconds")
  fileSizeBytes   BigInt?         @map("file_size_bytes")
  status          MediaStatus     @default(UPLOADED)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  campaignMedia   CampaignMedia[]
  advertiser      Advertiser      @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  playbackLogs    PlaybackLog[]
  playlistItems   PlaylistItem[]

  @@map("media")
}

model Campaign {
  id                    String                 @id @default(uuid())
  advertiserId          String                 @map("advertiser_id")
  name                  String
  objective             String?
  startDate             DateTime               @map("start_date") @db.Date
  endDate               DateTime               @map("end_date") @db.Date
  spotDuration          Int                    @default(15) @map("spot_duration")
  frequencyPerLoop      Int                    @default(1) @map("frequency_per_loop")
  status                CampaignStatus         @default(DRAFT)
  estimatedPrice        Decimal?               @map("estimated_price") @db.Decimal(12, 2)
  finalPrice            Decimal?               @map("final_price") @db.Decimal(12, 2)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  campaignMedia         CampaignMedia[]
  campaignScreens       CampaignScreen[]
  advertiser            Advertiser             @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  inventoryReservations InventoryReservation[]
  payments              Payment[]
  playbackLogs          PlaybackLog[]
  playlistItems         PlaylistItem[]

  @@map("campaigns")
}

model CampaignScreen {
  id              String       @id @default(uuid())
  campaignId      String       @map("campaign_id")
  screenId        String       @map("screen_id")
  status          EntityStatus @default(ACTIVE)
  reservedSeconds Int          @default(15) @map("reserved_seconds")
  createdAt       DateTime     @default(now()) @map("created_at")
  campaign        Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  screen          Screen       @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@unique([campaignId, screenId])
  @@map("campaign_screens")
}

model CampaignMedia {
  id              String   @id @default(uuid())
  campaignId      String   @map("campaign_id")
  mediaId         String   @map("media_id")
  displayOrder    Int      @default(1) @map("display_order")
  durationSeconds Int      @default(15) @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at")
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  media           Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([campaignId, mediaId, displayOrder])
  @@map("campaign_media")
}

model Playlist {
  id          String         @id @default(uuid())
  screenId    String         @map("screen_id")
  version     Int            @default(1)
  status      EntityStatus   @default(ACTIVE)
  generatedAt DateTime       @default(now()) @map("generated_at")
  publishedAt DateTime?      @map("published_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  items       PlaylistItem[]
  screen      Screen         @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@unique([screenId, version])
  @@map("playlists")
}

model PlaylistItem {
  id              String    @id @default(uuid())
  playlistId      String    @map("playlist_id")
  campaignId      String?   @map("campaign_id")
  mediaId         String    @map("media_id")
  position        Int
  durationSeconds Int       @default(15) @map("duration_seconds")
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  media           Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  playlist        Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@map("playlist_items")
}

model InventoryReservation {
  id              String            @id @default(uuid())
  campaignId      String            @map("campaign_id")
  screenId        String            @map("screen_id")
  startDate       DateTime          @map("start_date") @db.Date
  endDate         DateTime          @map("end_date") @db.Date
  reservedSeconds Int               @default(15) @map("reserved_seconds")
  status          ReservationStatus @default(TEMPORARY)
  expiresAt       DateTime?         @map("expires_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  campaign        Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  screen          Screen            @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@map("inventory_reservations")
}

model PlaybackLog {
  id              String         @id @default(uuid())
  playerId        String         @map("player_id")
  screenId        String         @map("screen_id")
  campaignId      String?        @map("campaign_id")
  mediaId         String         @map("media_id")
  startedAt       DateTime       @map("started_at")
  endedAt         DateTime?      @map("ended_at")
  durationSeconds Int?           @map("duration_seconds")
  status          PlaybackStatus @default(PLAYED)
  createdAt       DateTime       @default(now()) @map("created_at")
  campaign        Campaign?      @relation(fields: [campaignId], references: [id])
  media           Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  player          Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  screen          Screen         @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@map("playback_logs")
}

model Payment {
  id                   String          @id @default(uuid())
  advertiserId         String          @map("advertiser_id")
  campaignId           String?         @map("campaign_id")
  amount               Decimal         @db.Decimal(12, 2)
  currency             String          @default("XOF")
  provider             PaymentProvider
  transactionReference String?         @map("transaction_reference")
  externalId           String?         @map("external_id")
  status               PaymentStatus   @default(PENDING)
  paidAt               DateTime?       @map("paid_at")
  metadata             Json?           @default("{}")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  advertiser           Advertiser      @relation(fields: [advertiserId], references: [id])
  campaign             Campaign?       @relation(fields: [campaignId], references: [id])

  @@map("payments")
}

model PartnerPayout {
  id                   String          @id @default(uuid())
  partnerId            String          @map("partner_id")
  screenId             String?         @map("screen_id")
  periodStart          DateTime        @map("period_start") @db.Date
  periodEnd            DateTime        @map("period_end") @db.Date
  amount               Decimal         @db.Decimal(12, 2)
  paymentMethod        PaymentProvider @map("payment_method")
  transactionReference String?         @map("transaction_reference")
  status               PayoutStatus    @default(PENDING)
  paidAt               DateTime?       @map("paid_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  partner              Partner         @relation(fields: [partnerId], references: [id])
  screen               Screen?         @relation(fields: [screenId], references: [id])

  @@map("partner_payouts")
}

model Contract {
  id            String         @id @default(uuid())
  partnerId     String         @map("partner_id")
  screenId      String?        @map("screen_id")
  startDate     DateTime       @map("start_date") @db.Date
  endDate       DateTime       @map("end_date") @db.Date
  monthlyAmount Decimal        @default(20000.00) @map("monthly_amount") @db.Decimal(12, 2)
  status        ContractStatus @default(DRAFT)
  documentUrl   String?        @map("document_url")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  partner       Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  screen        Screen?        @relation(fields: [screenId], references: [id])

  @@map("contracts")
}

model MaintenanceTicket {
  id          String         @id @default(uuid())
  screenId    String?        @map("screen_id")
  playerId    String?        @map("player_id")
  reportedBy  String?        @map("reported_by")
  title       String
  description String?
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  assignedTo  String?        @map("assigned_to")
  openedAt    DateTime       @default(now()) @map("opened_at")
  resolvedAt  DateTime?      @map("resolved_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  assignee    User?          @relation("AssignedTo", fields: [assignedTo], references: [id])
  player      Player?        @relation(fields: [playerId], references: [id])
  reporter    User?          @relation("ReportedBy", fields: [reportedBy], references: [id])
  screen      Screen?        @relation(fields: [screenId], references: [id])

  @@map("maintenance_tickets")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType @default(INFO)
  title     String
  message   String
  read      Boolean          @default(false)
  readAt    DateTime?        @map("read_at")
  link      String?
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?    @default("{}")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model PricingRule {
  id                  String   @id @default(uuid())
  name                String
  zoneId              String?  @map("zone_id")
  screenId            String?  @map("screen_id")
  basePrice           Decimal  @default(50000.00) @map("base_price") @db.Decimal(12, 2)
  durationMultiplier  Decimal  @default(1.0) @map("duration_multiplier") @db.Decimal(5, 2)
  frequencyMultiplier Decimal  @default(1.0) @map("frequency_multiplier") @db.Decimal(5, 2)
  zoneMultiplier      Decimal  @default(1.0) @map("zone_multiplier") @db.Decimal(5, 2)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  screen              Screen?  @relation(fields: [screenId], references: [id])
  zone                Zone?    @relation(fields: [zoneId], references: [id])

  @@map("pricing_rules")
}

model ScreenCost {
  id          String    @id @default(uuid())
  screenId    String    @map("screen_id")
  costType    String    @map("cost_type")
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("XOF")
  isActual    Boolean   @default(false) @map("is_actual")
  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date
  description String?
  receiptUrl  String?   @map("receipt_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  screen      Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@map("screen_costs")
}

enum UserRole {
  ADMIN
  OPERATOR
  ADVERTISER
  PARTNER
}

enum AdvertiserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum ScreenStatus {
  ONLINE
  OFFLINE
  WARNING
  MAINTENANCE
  DECOMMISSIONED
}

enum PlayerStatus {
  ONLINE
  OFFLINE
  SYNCING
  ERROR
  UNREGISTERED
}

enum MediaStatus {
  UPLOADED
  PROCESSING
  APPROVED
  REJECTED
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  AWAITING_PAYMENT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  TEMPORARY
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum PlaybackStatus {
  PLAYED
  INTERRUPTED
  FAILED
  SKIPPED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  WAVE
  ORANGE_MONEY
  BANK_TRANSFER
  CASH
  OTHER
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}
