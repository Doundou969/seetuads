) {
  const user = await requireAuth();

  if (
    user.role !== "ADMIN" &&
    user.role !== "OPERATOR"
  ) {
    throw new Error(
      "Vous n'avez pas l'autorisation d'approuver un mÃ©dia."
    );
  }

  if (!id) {
    throw new Error("MÃ©dia introuvable.");
